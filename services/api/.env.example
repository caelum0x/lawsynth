LAWSYNTH_API_ENV=development
LAWSYNTH_DATABASE_URL=sqlite:///./lawsynth-api.sqlite3
LAWSYNTH_OBJECT_ROOT=./lawsynth-objects
LAWSYNTH_MAX_PAGE_SIZE=100
LAWSYNTH_MAX_UPLOAD_BYTES=67108864
LAWSYNTH_API_MAX_REQUEST_BYTES=67108864
# JSON map of bearer token to one organization and its permitted scopes.
LAWSYNTH_API_TOKENS_JSON={"replace-with-a-long-random-token":{"organization_id":"local","scopes":["read","write"]}}
