{
  "name": "@lawsynth/state-store",
  "version": "0.1.0",
  "description": "Deterministic dependency-free state store for LawSynth Studio.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0"
  },
  "engines": { "node": ">=20" },
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" }
}
