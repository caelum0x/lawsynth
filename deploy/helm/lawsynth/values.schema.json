{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "LawSynth Helm chart values",
  "description": "Schema for the lawsynth chart values. Validated by Helm on install/upgrade.",
  "type": "object",
  "additionalProperties": true,
  "required": ["global", "externalServices", "api", "scheduler", "worker", "artifact"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["imageRegistry", "imageNamespace", "imagePullPolicy"],
      "properties": {
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imageNamespace": { "type": "string", "minLength": 1 },
        "imageTag": { "type": "string" },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
        "storageClass": { "type": "string" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "observability": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] },
        "logFormat": { "type": "string", "enum": ["json", "text"] },
        "otelEnabled": { "type": "boolean" },
        "otelEndpoint": { "type": "string" }
      }
    },
    "externalServices": {
      "type": "object",
      "required": ["postgres", "objectStore", "nats"],
      "properties": {
        "postgres": {
          "type": "object",
          "required": ["host", "port", "database"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "sslMode": { "type": "string", "enum": ["disable", "require", "verify-ca", "verify-full"] },
            "existingSecret": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "objectStore": {
          "type": "object",
          "required": ["endpoint", "bucket"],
          "properties": {
            "endpoint": { "type": "string", "minLength": 1 },
            "region": { "type": "string" },
            "bucket": { "type": "string", "minLength": 1 },
            "forcePathStyle": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" }
          }
        },
        "nats": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "stream": { "type": "string" }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "api": { "$ref": "#/definitions/service" },
    "scheduler": { "$ref": "#/definitions/service" },
    "worker": { "$ref": "#/definitions/service" },
    "artifact": { "$ref": "#/definitions/service" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": { "create": { "type": "boolean" } }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
      }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "registry": { "type": "string" },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": { "type": "object" },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        }
      }
    }
  }
}
