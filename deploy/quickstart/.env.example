# LawSynth quickstart — environment template.
#
#   cp .env.example .env      # then set LAWSYNTH_API_TOKEN to a long random value
#
# These are LOCAL defaults for a trusted developer machine. The stack ships no
# TLS. Do not expose it to an untrusted network. For a hardened deployment see
# ../compose/production.

# ---------------------------------------------------------------------------
# API environment: development | test | staging | production.
# `production` requires durable (non :memory:) SQLite and an absolute object
# root — the quickstart compose already satisfies both.
# ---------------------------------------------------------------------------
LAWSYNTH_API_ENV=production

# ---------------------------------------------------------------------------
# Bearer token the API accepts. MUST be at least 16 characters. Regenerate this
# before any shared use, e.g.:  openssl rand -hex 24
# The compose file expands it into LAWSYNTH_API_TOKENS_JSON as:
#   {"<token>": {"organization_id": "local", "scopes": ["read","write"]}}
# ---------------------------------------------------------------------------
LAWSYNTH_API_TOKEN=quickstart-local-token-change-me

# ---------------------------------------------------------------------------
# Host port mappings.
# ---------------------------------------------------------------------------
LAWSYNTH_API_HOST_PORT=8080
LAWSYNTH_GATEWAY_HOST_PORT=8081

# ---------------------------------------------------------------------------
# Gateway admission policy.
# ---------------------------------------------------------------------------
LAWSYNTH_GATEWAY_MAX_BODY_BYTES=67108864
LAWSYNTH_GATEWAY_REQUESTS_PER_WINDOW=120
LAWSYNTH_GATEWAY_RATE_WINDOW_SECONDS=60
# Comma-separated bare http(s) origins allowed through CORS (no path/query).
LAWSYNTH_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
